{
  "name": "dsh-split-panels",
  "version": "2026.10.30-1",
  "private": false,
  "description": "DSH Web 增强插件：对话区横向分屏（1–3 栏）+ 右侧文档预览导出 PDF。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "GPL-3.0-only",
  "author": "HZWzzl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HZWzzl/dsh-split-panels.git"
  },
  "homepage": "https://github.com/HZWzzl/dsh-split-panels",
  "bugs": {
    "url": "https://github.com/HZWzzl/dsh-split-panels/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "split-panel",
    "split-screen",
    "multi-session",
    "tmux",
    "export",
    "pdf",
    "markdown"
  ],
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm build && git diff --exit-code -- lib/",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
